# Environment variables understood by the project. None of them holds a secret: keys live in ./secrets (gitignored),
# created by `python scripts/gen_keys.py` and `python scripts/gen_certs.py`. Copy to .env only if you want to override.

# ---- locations -----------------------------------------------------------------------------------------------
# FEDHEALTH_ROOT=               project root (default: two directories above fedhealth/common/config.py)
# FEDHEALTH_CONFIG_DIR=         directory holding topology.yaml, fields.yaml, policy.yaml
# FEDHEALTH_DATA_DIR=           where the SQLite files live (default ./data)
# FEDHEALTH_SECRETS_DIR=        data keys, JWT secret, audit key, users.json, tls/ (default ./secrets)
# FEDHEALTH_TLS_DIR=            CA + service certificates (default <secrets>/tls)

# ---- topology ------------------------------------------------------------------------------------------------
# FEDHEALTH_HOST_A=hospital-a   host name of a hospital / the coordinator (Docker Compose sets these)
# FEDHEALTH_HOST_COORDINATOR=coordinator
# FEDHEALTH_PORT_OFFSET=0       shift every port (tests run next to a dev system with this)
# FEDHEALTH_SCHEME=http         http | https

# ---- modes ---------------------------------------------------------------------------------------------------
# FEDHEALTH_STRICT=1            TLS + service identities + private API + keys required (what Compose uses)
# ALLOW_INSECURE_BASELINE=0     mount the INSECURE baseline routes (evaluation only; NEVER in a deployment)
# ALLOW_PLAINTEXT_DB=0          let a hospital start without its data key (control experiments only)
# FEDHEALTH_PSI_GROUP=modp2048  modp2048 | modp1536 | test768 (test768 is INSECURE: tests only)
# FEDHEALTH_NO_GMPY2=0          force pure-Python modular exponentiation (to measure the gmpy2 speed-up)

# ---- dashboard -----------------------------------------------------------------------------------------------
# FEDHEALTH_COORDINATOR_URL=https://127.0.0.1:8000
# FEDHEALTH_CA=secrets/tls/ca.pem
# FEDHEALTH_DEMO_MODE=0         1 = show the "ground truth (demo mode only)" toggle (needs FEDHEALTH_GT_DIR)
# FEDHEALTH_GT_DIR=data/ground_truth
